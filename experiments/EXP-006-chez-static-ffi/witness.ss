(define noarg (foreign-procedure "project_noarg" () integer-32))
(define signed (foreign-procedure "project_signed" (integer-32) integer-32))
(define unsigned (foreign-procedure "project_unsigned" (unsigned-32) unsigned-32))
(define pointer (foreign-procedure "project_pointer" (void*) void*))
(define utf8-bytes (foreign-procedure "project_utf8_bytes" (string) integer-32))
(define allocate (foreign-procedure "project_alloc" (unsigned-64) void*))
(define read-first (foreign-procedure "project_read_first" (void*) integer-32))
(define write-first (foreign-procedure "project_write_first" (void* integer-32) void))
(define release (foreign-procedure "project_free" (void*) void))

(define (assert= label actual expected)
  (unless (= actual expected) (error 'EXP-006 label actual expected)))

(define (run-witness)
  (assert= 'noarg (noarg) 73)
  (assert= 'signed (signed -12) -21)
  (assert= 'unsigned (unsigned 35) 42)
  (let ([p (allocate 1)])
    (unless p (error 'EXP-006 "allocation failed"))
    (write-first p 90)
    (assert= 'pointer (if (eq? p (pointer p)) 1 0) 1)
    (assert= 'memory (read-first p) 90)
    (release p))
  (assert= 'utf8 (utf8-bytes "λ東京") 8)
  (display "EXP-006-STATIC-FFI-OK\n")
  (exit))

(scheme-start run-witness)
