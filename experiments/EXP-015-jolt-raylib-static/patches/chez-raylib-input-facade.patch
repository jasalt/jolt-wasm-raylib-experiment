+#ifdef __EMSCRIPTEN__
+static void project_init(void) {
+  Sforeign_symbol("project_set_scene", (void *)project_set_scene);
+  Sforeign_symbol("project_set_input_mode", (void *)project_set_input_mode);
+}
+#define CUSTOM_INIT project_init
+#else
