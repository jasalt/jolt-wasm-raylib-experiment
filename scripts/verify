#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
log_dir="$root/artifacts/logs/verify"
summary="$root/artifacts/reports/verify-summary.txt"
mkdir -p "$log_dir" "$(dirname -- "$summary")"
run() { local name=$1; shift; "$@" 2>&1 | tee "$log_dir/$name.log"; }
run bootstrap "$root/scripts/bootstrap"
run native "$root/scripts/test-native"
run nrepl "$root/scripts/nrepl-smoke"
if [[ "${VERIFY_CHEZ_NODE:-0}" == 1 ]]; then
  run chez-pb-node "$root/experiments/EXP-001-chez-pb-node/commands.sh"
else
  printf 'SKIP chez-pb-node: set VERIFY_CHEZ_NODE=1 to rebuild the stock Chez Node witness\n' | tee "$log_dir/chez-pb-node-skip.log"
fi
if [[ "${VERIFY_BROWSER:-0}" == 1 ]]; then
  run raylib-web "$root/scripts/browser-smoke"
else
  printf 'SKIP raylib-web: set VERIFY_BROWSER=1 to run Chromium visual validation\n' | tee "$log_dir/raylib-web-skip.log"
fi
printf '%s\n' \
  'PASS bootstrap/native/nREPL: supported native tiers completed.' \
  'SKIP Jolt Node/browser/Raylib/input/debug: pinned Jolt aborts at make-mutex on non-threaded pb; see EXP-008.' \
  'SKIP stress/performance: no initialized Jolt browser runtime; Chez-only timing would not satisfy the gate.' \
  'PASS report consistency: REPORT.md records W3 and does not claim Jolt browser execution.' \
  >"$summary"
printf 'Wrote %s\n' "$summary"
