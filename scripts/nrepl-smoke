#!/usr/bin/env bash
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
log="$root/artifacts/logs/EXP-000/nrepl-smoke.log"
mkdir -p "$(dirname -- "$log")"
cd "$root"
"${JOLT_BIN:-$root/../jolt/bin/jolt}" nrepl-server 7888 >"$log" 2>&1 &
pid=$!
cleanup() { kill "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true; }
trap cleanup EXIT
for _ in $(seq 1 100); do
  if python3 - <<'PY' 2>/dev/null
import socket
with socket.create_connection(("127.0.0.1", 7888), timeout=.2):
    pass
PY
  then
    printf 'loopback nREPL TCP connection: PASS\n' | tee -a "$log"
    exit 0
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    printf 'nREPL process exited unexpectedly; see %s\n' "$log" >&2
    exit 1
  fi
  sleep .1
done
printf 'nREPL did not accept a loopback TCP connection; see %s\n' "$log" >&2
exit 1
